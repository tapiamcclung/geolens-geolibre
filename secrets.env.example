GEOLENS_VERSION="latest"
GEOLIBRE_WEB_IMAGE="ghcr.io/opengeos/geolibre:latest"

ALLOW_FLOATING_GEOLENS_IMAGE=1
ALLOW_FLOATING_GEOLIBRE_IMAGE=1

# GeoLibre database
GEOLIBRE_POSTGRES_USER=<user>
GEOLIBRE_POSTGRES_PASSWORD='<password>'

# GeoLens database
GEOLENS_POSTGRES_USER=<user>
GEOLENS_POSTGRES_PASSWORD=<password>

# GeoLens authentication and encryption
GEOLENS_JWT_SECRET_KEY=<jwt_secret_key>
GEOLENS_SECRET_ENCRYPTION_KEY=<geolens_key>
GEOLENS_ADMIN_PASSWORD=<geloens_admin_pw>

# GeoLens MinIO
GEOLENS_MINIO_ROOT_USER=<minio_root>
GEOLENS_MINIO_ROOT_PASSWORD=<minio_pw>

# SMTP
SMTP_USERNAME=<email>
SMTP_PASSWORD='<pw>'
